// Schema do banco de dados do SGA — Sistema de Gestão de Autorizações
// Modelo unificado a partir do sistema integrado (frontfisiomed): Usuario,
// Paciente, Convenio, PacienteConvenio, Autorizacao e Atendimento, mais a
// trilha de auditoria HistoricoStatus da proposta técnica.
//
// Os valores dos enums ficam em minúsculas porque são os mesmos usados pela
// API e pelas telas (ex.: status "em_analise").

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums -----------------------------------------------------------

// Dois perfis. O atendente faz o trabalho do dia e consulta os cadastros; o
// administrador também edita os cadastros, gerencia os usuários e baixa os
// XMLs trocados com a operadora (src/lib/auth/sessao.ts: exigirAdmin).
enum PerfilUsuario {
  admin
  atendente
}

// Máquina de estados da autorização. As transições válidas ficam em
// src/lib/regras/autorizacao.ts.
enum StatusAutorizacao {
  pendente
  em_analise
  autorizada
  negada
  vencida
  cancelada
  esgotada
}

enum StatusCobranca {
  pendente
  faturado
  pago
  glosado
  cancelado
}

// manual: autorizações feitas fora do sistema (portal). tiss_amil: pedidos
// enviados pelo webservice TISS da Amil.
enum TipoIntegracao {
  manual
  tiss_amil
}

enum TipoImportacao {
  agenda
  profissionais
  documentos
  tabela_operadora
  tuss
}

enum TipoDocumento {
  pedido_medico
  plano_terapeutico
  relatorio
  outro
}

// Atendimentos criados a partir da agenda esperam o operador confirmar que a
// sessão aconteceu (ou cancelar, com motivo).
enum SituacaoAtendimento {
  aguardando_confirmacao
  confirmado
  cancelado
}

// --- Entidades ---------------------------------------------------------

model Usuario {
  id           String        @id @default(uuid()) @db.Uuid
  nome         String        @db.VarChar(150)
  email        String        @unique @db.VarChar(255)
  senhaHash    String
  perfil       PerfilUsuario @default(admin)
  ativo        Boolean       @default(true)
  ultimoAcesso DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  autorizacoesCriadas     Autorizacao[]     @relation("AutorizacaoCriadaPor")
  atendimentosRealizados  Atendimento[]     @relation("AtendimentoTerapeuta")
  atendimentosConfirmados Atendimento[]     @relation("AtendimentoConfirmadoPor")
  documentos              Documento[]
  historicoStatus         HistoricoStatus[]
  importacoes             Importacao[]
  pedidosMedicos          PedidoMedico[]
  guiasTiss               GuiaTiss[]

  @@map("usuarios")
}

model Paciente {
  id             String    @id @default(uuid()) @db.Uuid
  nome           String    @db.VarChar(200)
  dataNascimento DateTime? @db.Date // pode faltar em pacientes vindos do AnClinic
  cpf            String?   @unique @db.VarChar(14)
  responsavel    String?   @db.VarChar(200)
  telefone       String?   @db.VarChar(20)
  email          String?   @db.VarChar(255)
  endereco       String?
  diagnostico    String?
  cid            String?   @db.VarChar(20) // CID-10 do diagnóstico principal
  ativo          Boolean   @default(true)
  observacoes    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  vinculos       PacienteConvenio[]
  autorizacoes   Autorizacao[]
  atendimentos   Atendimento[]
  agendamentos   Agendamento[]
  pedidosMedicos PedidoMedico[]
  Documento      Documento[]
  guiasTiss      GuiaTiss[]

  @@index([nome])
  @@map("pacientes")
}

model Convenio {
  id                    String         @id @default(uuid()) @db.Uuid
  nome                  String         @unique @db.VarChar(200)
  codigoAns             String?        @db.VarChar(20) // código da operadora na ANS
  cnpj                  String?        @db.VarChar(18)
  contatoNome           String?        @db.VarChar(150)
  contatoTelefone       String?        @db.VarChar(20)
  contatoEmail          String?        @db.VarChar(255)
  prazoAutorizacaoDias  Int            @default(30)
  alertaAntecipacaoDias Int            @default(7)
  procedimentosCobertos String[]       @default([])
  ativo                 Boolean        @default(true)
  observacoes           String?
  // Integração: código da clínica nesta operadora (TISS) e os nomes com que
  // o convênio aparece na agenda exportada do AnClinic.
  integracao            TipoIntegracao @default(manual)
  codigoPrestador       String?        @db.VarChar(20)
  nomesAnclinic         String[]       @default([])
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  vinculos       PacienteConvenio[]
  autorizacoes   Autorizacao[]
  agendamentos   Agendamento[]
  credenciados   ProfissionalConvenio[]
  pedidosMedicos PedidoMedico[]
  tabela         ProcedimentoOperadora[]
  guiasTiss      GuiaTiss[]

  @@map("convenios")
}

// Vínculo paciente ↔ convênio (carteirinha). Um paciente pode ter vários.
model PacienteConvenio {
  id                String    @id @default(uuid()) @db.Uuid
  pacienteId        String    @db.Uuid
  convenioId        String    @db.Uuid
  numeroCarteirinha String    @db.VarChar(100)
  plano             String?   @db.VarChar(100)
  titular           String?   @db.VarChar(200) // se diferente do paciente
  dataValidade      DateTime? @db.Date
  ativo             Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Última verificação de elegibilidade na operadora (rotina ou botão).
  elegivel            Boolean?
  elegibilidadeEm     DateTime?
  elegibilidadeMotivo String?

  paciente     Paciente      @relation(fields: [pacienteId], references: [id])
  convenio     Convenio      @relation(fields: [convenioId], references: [id])
  autorizacoes Autorizacao[]

  @@unique([pacienteId, convenioId])
  @@map("paciente_convenios")
}

model Autorizacao {
  id                   String            @id @default(uuid()) @db.Uuid
  pacienteId           String            @db.Uuid
  convenioId           String            @db.Uuid
  pacienteConvenioId   String?           @db.Uuid
  numeroAutorizacao    String?           @db.VarChar(100) // fornecido pelo convênio
  protocolo            String?           @db.VarChar(100)
  procedimento         String            @db.VarChar(200)
  codigoProcedimento   String?           @db.VarChar(30) // TUSS/CBHPM
  quantidadeSolicitada Int               @default(1)
  quantidadeAutorizada Int?
  quantidadeUtilizada  Int               @default(0)
  dataInicioVigencia   DateTime?         @db.Date
  dataFimVigencia      DateTime?         @db.Date
  dataSolicitacao      DateTime          @default(now()) @db.Date
  dataResposta         DateTime?         @db.Date
  status               StatusAutorizacao @default(pendente)
  motivoNegativa       String?
  usuarioCriouId       String?           @db.Uuid
  observacoes          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  paciente     Paciente          @relation(fields: [pacienteId], references: [id])
  convenio     Convenio          @relation(fields: [convenioId], references: [id])
  vinculo      PacienteConvenio? @relation(fields: [pacienteConvenioId], references: [id])
  usuarioCriou Usuario?          @relation("AutorizacaoCriadaPor", fields: [usuarioCriouId], references: [id])
  atendimentos Atendimento[]
  historico    HistoricoStatus[]

  @@index([status])
  @@index([dataFimVigencia])
  @@index([pacienteId])
  @@map("autorizacoes")
}

// Trilha de auditoria — uma linha por mudança de status.
model HistoricoStatus {
  id             String             @id @default(uuid()) @db.Uuid
  autorizacaoId  String             @db.Uuid
  statusAnterior StatusAutorizacao?
  statusNovo     StatusAutorizacao
  observacao     String?
  usuarioId      String?            @db.Uuid // nulo = mudança automática do sistema
  createdAt      DateTime           @default(now())

  autorizacao Autorizacao @relation(fields: [autorizacaoId], references: [id], onDelete: Cascade)
  usuario     Usuario?    @relation(fields: [usuarioId], references: [id])

  @@index([autorizacaoId])
  @@map("historico_status")
}

model Atendimento {
  id                 String              @id @default(uuid()) @db.Uuid
  pacienteId         String              @db.Uuid
  autorizacaoId      String?             @db.Uuid
  terapeutaId        String?             @db.Uuid
  dataAtendimento    DateTime            @db.Date
  horaInicio         String?             @db.VarChar(5) // HH:MM
  horaFim            String?             @db.VarChar(5)
  procedimento       String              @db.VarChar(200)
  codigoProcedimento String?             @db.VarChar(30)
  statusCobranca     StatusCobranca      @default(pendente)
  motivoGlosa        String?
  semAutorizacao     Boolean             @default(false) // realizado sem autorização vigente
  evolucao           String? // não é mais preenchida pelo formulário
  observacoes        String?
  situacao           SituacaoAtendimento @default(confirmado)
  motivoCancelamento String?
  confirmadoEm       DateTime?
  confirmadoPorId    String?             @db.Uuid
  agendamentoId      String?             @unique @db.Uuid // sessão da agenda que originou
  profissionalId     String?             @db.Uuid
  procedimentoId     String?             @db.Uuid
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  paciente        Paciente      @relation(fields: [pacienteId], references: [id])
  autorizacao     Autorizacao?  @relation(fields: [autorizacaoId], references: [id])
  terapeuta       Usuario?      @relation("AtendimentoTerapeuta", fields: [terapeutaId], references: [id])
  confirmadoPor   Usuario?      @relation("AtendimentoConfirmadoPor", fields: [confirmadoPorId], references: [id])
  agendamento     Agendamento?  @relation(fields: [agendamentoId], references: [id], onDelete: SetNull)
  profissional    Profissional? @relation(fields: [profissionalId], references: [id])
  procedimentoRef Procedimento? @relation(fields: [procedimentoId], references: [id])

  @@index([dataAtendimento])
  @@index([statusCobranca])
  @@index([situacao])
  @@map("atendimentos")
}

// --- Integração AnClinic / TISS ------------------------------------------

// Dados da clínica usados no cabeçalho das guias TISS. Uma linha só.
model Clinica {
  id           String   @id @default(uuid()) @db.Uuid
  razaoSocial  String   @db.VarChar(200)
  nomeFantasia String?  @db.VarChar(200)
  cnpj         String   @db.VarChar(18)
  updatedAt    DateTime @updatedAt

  @@map("clinica")
}

// Unidade de atendimento (cada uma com seu CNES).
model Unidade {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @db.VarChar(150)
  nomeAnclinic   String   @unique @db.VarChar(200) // como aparece na agenda
  cnes           String?  @db.VarChar(7)
  cep            String?  @db.VarChar(9)
  tipoLogradouro String?  @db.VarChar(30)
  logradouro     String?  @db.VarChar(200)
  numero         String?  @db.VarChar(20)
  complemento    String?  @db.VarChar(100)
  bairro         String?  @db.VarChar(100)
  municipio      String?  @db.VarChar(100)
  uf             String?  @db.VarChar(2)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agendamentos Agendamento[]

  @@map("unidades")
}

// Profissional executante (terapeuta), com os dados de conselho que a guia exige.
model Profissional {
  id             String   @id @default(uuid()) @db.Uuid
  nome           String   @db.VarChar(200)
  cpf            String   @unique @db.VarChar(11) // só dígitos
  cns            String?  @db.VarChar(15)
  conselho       String?  @db.VarChar(10) // CRP, CREFITO, CRFA…
  numeroConselho String?  @db.VarChar(15)
  ufConselho     String?  @db.VarChar(2)
  cbo            String?  @db.VarChar(6)
  especialidades String?  @db.VarChar(300)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  credenciamentos ProfissionalConvenio[]
  agendamentos    Agendamento[]
  atendimentos    Atendimento[]

  @@index([nome])
  @@map("profissionais")
}

// Profissional cadastrado (credenciado) na operadora.
model ProfissionalConvenio {
  profissionalId String   @db.Uuid
  convenioId     String   @db.Uuid
  createdAt      DateTime @default(now())

  profissional Profissional @relation(fields: [profissionalId], references: [id], onDelete: Cascade)
  convenio     Convenio     @relation(fields: [convenioId], references: [id], onDelete: Cascade)

  @@id([profissionalId, convenioId])
  @@map("profissional_convenios")
}

// Procedimento como cadastrado no AnClinic, com o código TUSS da guia.
model Procedimento {
  id             String   @id @default(uuid()) @db.Uuid
  codigoAnclinic String   @unique @db.VarChar(20)
  descricao      String   @db.VarChar(200)
  codigoTuss     String?  @db.VarChar(10)
  tabelaTuss     String?  @db.VarChar(2) // 22 = TUSS procedimentos, 98 = tabela própria…
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agendamentos  Agendamento[]
  atendimentos  Atendimento[]
  equivalencias ProcedimentoOperadora[]

  @@map("procedimentos")
}

// Sessão da agenda importada do AnClinic. Os campos "*Anclinic" guardam o
// texto original, para conferência e para vincular depois.
model Agendamento {
  id                    String    @id @default(uuid()) @db.Uuid
  idAnclinic            String    @unique @db.VarChar(20)
  data                  DateTime  @db.Date
  horaInicio            String?   @db.VarChar(5)
  horaFim               String?   @db.VarChar(5)
  pacienteId            String?   @db.Uuid
  profissionalId        String?   @db.Uuid
  convenioId            String?   @db.Uuid
  procedimentoId        String?   @db.Uuid
  unidadeId             String?   @db.Uuid
  pacienteAnclinic      String?   @db.VarChar(200)
  convenioAnclinic      String?   @db.VarChar(200)
  carteirinha           String?   @db.VarChar(100)
  statusAnclinic        String?   @db.VarChar(60)
  statusFaturamento     String?   @db.VarChar(60)
  senhaAutorizacao      String?   @db.VarChar(40)
  senhaExecucao         String?   @db.VarChar(40)
  agendamentosRestantes Int?
  agenda                String?   @db.VarChar(200)
  sala                  String?   @db.VarChar(200)
  removidoEm            DateTime? // sumiu de uma importação posterior do mesmo dia
  unidadeManual         Boolean   @default(false) // unidade escolhida no sistema: a importação não troca
  // Token do beneficiário (codValidacao da guia TISS): a equipe pega com o
  // paciente no dia da sessão e ele vale só nesse dia. A importação não mexe.
  tokenBeneficiario     String?   @db.VarChar(10)
  tokenInformadoEm      DateTime?
  importacaoId          String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  paciente     Paciente?     @relation(fields: [pacienteId], references: [id])
  profissional Profissional? @relation(fields: [profissionalId], references: [id])
  convenio     Convenio?     @relation(fields: [convenioId], references: [id])
  procedimento Procedimento? @relation(fields: [procedimentoId], references: [id])
  unidade      Unidade?      @relation(fields: [unidadeId], references: [id])
  importacao   Importacao?   @relation(fields: [importacaoId], references: [id], onDelete: SetNull)
  atendimento  Atendimento?

  @@index([data])
  @@index([pacienteId])
  @@map("agendamentos")
}

// Registro de cada arquivo importado, com o resumo mostrado ao usuário.
model Importacao {
  id          String         @id @default(uuid()) @db.Uuid
  tipo        TipoImportacao
  arquivoNome String         @db.VarChar(255)
  usuarioId   String?        @db.Uuid
  linhas      Int            @default(0)
  criados     Int            @default(0)
  atualizados Int            @default(0)
  ignorados   Int            @default(0)
  resumo      Json // avisos agrupados, período, contagens por convênio…
  createdAt   DateTime       @default(now())

  usuario      Usuario?      @relation(fields: [usuarioId], references: [id])
  agendamentos Agendamento[]

  @@index([createdAt])
  @@map("importacoes")
}

// Pedido médico que acompanha a solicitação de autorização: dados do médico
// solicitante e do diagnóstico, mais os PDFs enviados como anexo.
model PedidoMedico {
  id               String    @id @default(uuid()) @db.Uuid
  pacienteId       String    @db.Uuid
  convenioId       String?   @db.Uuid
  medicoNome       String    @db.VarChar(200)
  conselho         String    @default("CRM") @db.VarChar(10)
  numeroConselho   String    @db.VarChar(15)
  ufConselho       String    @db.VarChar(2)
  cbo              String?   @db.VarChar(6)
  cid              String?   @db.VarChar(20)
  indicacaoClinica String?
  sessoesSemanais  Int? // do plano terapêutico
  planoItens       Json? // [{ especialidade, dias: {seg..sab}, total }]
  dataPedido       DateTime  @db.Date
  validoAte        DateTime? @db.Date
  ativo            Boolean   @default(true)
  observacoes      String?
  usuarioId        String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  paciente   Paciente    @relation(fields: [pacienteId], references: [id])
  convenio   Convenio?   @relation(fields: [convenioId], references: [id])
  usuario    Usuario?    @relation(fields: [usuarioId], references: [id])
  documentos Documento[]
  guiasTiss  GuiaTiss[]

  @@index([pacienteId])
  @@map("pedidos_medicos")
}

// Documento do paciente (PDF) gravado em disco (ARQUIVOS_DIR), fora da pasta
// pública. Pode estar ligado a um pedido médico ou avulso (enviado em lote sem
// pedido ainda cadastrado).
model Documento {
  id           String        @id @default(uuid()) @db.Uuid
  pacienteId   String        @db.Uuid
  pedidoId     String?       @db.Uuid
  tipo         TipoDocumento
  nomeOriginal String        @db.VarChar(255)
  caminho      String        @db.VarChar(255) // relativo a ARQUIVOS_DIR
  tamanho      Int
  sha256       String        @db.VarChar(64)
  dados        Json? // dados lidos do plano terapêutico
  origem       String        @default("manual") @db.VarChar(10) // manual | lote
  usuarioId    String?       @db.Uuid
  createdAt    DateTime      @default(now())

  paciente Paciente      @relation(fields: [pacienteId], references: [id])
  pedido   PedidoMedico? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuario  Usuario?      @relation(fields: [usuarioId], references: [id])

  @@unique([pacienteId, sha256]) // o mesmo arquivo não entra duas vezes
  @@index([pedidoId])
  @@map("documentos")
}

// Tabela 22 da TUSS (ANS): códigos de procedimentos e eventos.
model TussProcedimento {
  codigo String @id @db.VarChar(10)
  termo  String @db.VarChar(500)

  @@map("tuss_procedimentos")
}

// Tabela de procedimentos da operadora e o de/para: código do AnClinic →
// código da operadora → código TUSS (tabela 22).
model ProcedimentoOperadora {
  id             String   @id @default(uuid()) @db.Uuid
  convenioId     String   @db.Uuid
  procedimentoId String?  @db.Uuid // procedimento do AnClinic equivalente
  codigo         String   @db.VarChar(20)
  descricao      String   @db.VarChar(300)
  tabela         String   @default("22") @db.VarChar(2) // 22 TUSS, 98/00 próprias
  codigoTuss     String?  @db.VarChar(10)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  convenio     Convenio      @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  procedimento Procedimento? @relation(fields: [procedimentoId], references: [id], onDelete: SetNull)

  @@unique([convenioId, codigo])
  @@unique([convenioId, procedimentoId]) // um equivalente por procedimento em cada operadora
  @@map("procedimentos_operadora")
}

// Guia TISS montada pelo sistema a partir das sessões prontas da agenda. Por
// enquanto só o XML, para baixar e conferir; o envio à operadora (protocolo,
// resposta) entra junto com o webservice.
model GuiaTiss {
  id                 String    @id @default(uuid()) @db.Uuid
  numero             Int       @unique @default(autoincrement()) // nº da guia no prestador
  convenioId         String    @db.Uuid
  pacienteId         String    @db.Uuid
  pedidoId           String?   @db.Uuid
  agendamentoIds     String[]  @db.Uuid // sessões da agenda cobertas pelo pedido
  dataSessao         DateTime? @db.Date // dia da sessão quando a guia foi gerada
  codigoProcedimento String    @db.VarChar(10)
  quantidade         Int
  versaoTiss         String    @db.VarChar(8)
  xml                String // como vai para a operadora (ISO-8859-1)
  hash               String    @db.VarChar(32)
  usuarioId          String?   @db.Uuid
  createdAt          DateTime  @default(now())

  // Envio ao webservice da operadora (solicitacaoProcedimento) e a resposta.
  enviadaEm           DateTime?
  statusOperadora     String?   @db.VarChar(1) // tabela TISS dm_statusSolicitacao: 1 autorizado, 2 em análise, 3 negado…
  numeroGuiaOperadora String?   @db.VarChar(20)
  senhaOperadora      String?   @db.VarChar(20)
  validadeSenha       DateTime? @db.Date
  glosas              String[] // "código - descrição" das negativas e mensagens de erro
  erroEnvio           String? // falha de comunicação ou tissFault
  conferir            String? // resposta sem o que foi liberado, ou envio sem resposta: conferir no portal
  respostaXml         String?

  // Rotina: consulta do status enquanto a guia está em análise na operadora.
  consultasStatus   Int       @default(0)
  proximaConsultaEm DateTime?

  // Cancelamento da guia na operadora (cancelaGuia).
  canceladaEm        DateTime?
  motivoCancelamento String?
  erroCancelamento   String?

  convenio Convenio      @relation(fields: [convenioId], references: [id])
  paciente Paciente      @relation(fields: [pacienteId], references: [id])
  pedido   PedidoMedico? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  usuario  Usuario?      @relation(fields: [usuarioId], references: [id])

  @@index([pacienteId])
  @@index([createdAt])
  @@map("guias_tiss")
}
