# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# Conexão com o PostgreSQL instalado no próprio servidor (AWS).
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Se a senha tiver caracteres especiais (@, :, /, #...), prefira uma senha só
# com letras e números, ou codifique-os (ex: @ vira %40).
DATABASE_URL="postgresql://sga:troque-esta-senha@localhost:5432/sga?schema=public"

# Chave secreta para assinar os tokens de login.
# Gere uma com:  openssl rand -base64 48
JWT_SECRET="troque-por-uma-string-aleatoria-grande"
