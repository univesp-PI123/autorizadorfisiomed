# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

# String de conexão do Neon (Settings > Connection string no painel do Neon)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo.neon.tech/sga?sslmode=require"

# Chave secreta para assinar os tokens de login (gere uma string aleatória longa)
JWT_SECRET="troque-por-uma-string-aleatoria-grande"
